package Bucles_Condicionales;

import java.util.Scanner;

public class _04Juego_Mayor {

	public static void main(String[] args) {
		System.out.println("----Juego número mayor----");
		Scanner sc = new Scanner(System.in);
		int num1 = 0;
		int num2 = 0;
		System.out.println("Introduce el primer numero");
		num1 = sc.nextInt();
		if (num1 <= 0) {
			System.out.println("Solo positivos");
		} else {
			System.out.println("Intoduce el segundo numero");
			num2 = sc.nextInt();
			if (num2 <= 0) {
				System.out.println("Solo positivos");
			} else {
				if (num1 <= num2) {
					System.out.println("El mayor seria---> " + num2);
				} else {
					System.out.println("El mayor seria---> " + num1);
				}
				while (num1 >= 0 || num2 >= 0) {
					System.out.println("Introduce el primer numero");
					num1 = sc.nextInt();
					System.out.println("Intoduce el segundo numero");
					num2 = sc.nextInt();
					System.out.println(num1 + " , " + num2);
					if (num1 <= num2) {
						if (num1 >= 0)
							System.out.println("El mayor seria---> " + num2);
						else {
							break;
						}
					} else {
						if (num2 >= 0)
							System.out.println("El mayor seria---> " + num1);
						else {
							break;
						}
					}
				}
			}
			System.out.println("-------------------");
		}
		if (num1 <= num2) {
			System.out.println("Has introducido un numero negativo el mayor seria---> " + num2);
		} else {
			System.out.println("Has introducido un numero negativo el mayor seria---> " + num1);
		}

	}

}
